        "jsCode": "const now = Buffer.from(new Date().toISOString()).toString(); // Timestamp\nconst date = new Date();\nconst hours = date.getHours();\nconst minutes = date.getMinutes();\nconst currentTimeInMinutes = hours * 60 + minutes;\n\nlet shift_name = \"\";\nlet is_pause = false;\n\n// 1. Дефиниција Смена и Пауза (у минутима од поноћи)\n// Смена 1: 06:00 (360) - 14:00 (840) | Пауза: 13:30 (810) - 14:30 (870)\n// Смена 2: 14:00 (840) - 22:00 (1320) | Пауза: 21:30 (1290) - 22:30 (1350)\n// Смена 3: 22:00 (1320) - 06:00 (360) | Пауза: 05:30 (330) - 06:30 (390)\n\nif (currentTimeInMinutes >= 360 && currentTimeInMinutes < 840) {\n    shift_name = \"Shift_1\";\n} else if (currentTimeInMinutes >= 840 && currentTimeInMinutes < 1320) {\n    shift_name = \"Shift_2\";\n} else {\n    shift_name = \"Shift_3\";\n}\n\n// 2. Провера Паузе\nconst pauses = [\n    { start: 810, end: 870 },  // 13:30 - 14:30\n    { start: 1290, end: 1350 }, // 21:30 - 22:30\n    { start: 330, end: 390 }    // 05:30 - 06:30\n];\n\nfor (let p of pauses) {\n    if (currentTimeInMinutes >= p.start && currentTimeInMinutes < p.end) {\n        is_pause = true;\n        break;\n    }\n}\n\n// 3. Генерисање јединственог Shift ID-а (нпр. 2026-03-20-Shift_1)\nconst shift_id = `${date.toISOString().split('T')[0]}-${shift_name}`;\n\nreturn {\n    shift_id,\n    shift_name,\n    is_pause,\n    timestamp: date.toISOString()\n};"
