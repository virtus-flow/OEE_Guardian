    {
      "parameters": {
        "jsCode": "// 1. ПРЕУЗИМАЊЕ ПОДАТАКА (n8n v1.0+ стандард)\nconst inputData = $input.first().json; \nconst lastPieceRaw = inputData.last_piece_time;\n\nif (!lastPieceRaw) return { should_alert: false, status: \"EMPTY_DB\" };\n\nconst now = new Date();\nconst lastSeen = new Date(lastPieceRaw);\nconst diffSeconds = Math.floor((now - lastSeen) / 1000);\nconst diffMinutes = Math.floor(diffSeconds / 60);\n\n// 2. ПРОВЕРА ПАУЗА\nconst currentTimeInMinutes = now.getHours() * 60 + now.getMinutes();\nlet isPlannedPause = false;\nconst pauses = [{start: 810, end: 870}, {start: 1290, end: 1350}, {start: 330, end: 390}];\n\nfor (let p of pauses) {\n    if (currentTimeInMinutes >= p.start && currentTimeInMinutes < p.end) {\n        isPlannedPause = true; break;\n    }\n}\n\n// 3. ЛОГИКА АЛАРМА\nconst shouldAlert = diffMinutes >= 3 && !isPlannedPause;\n\nreturn {\n  should_alert: shouldAlert,\n  minutes_silent: diffMinutes,\n  last_active: lastSeen.toLocaleTimeString('sr-RS'),\n  telegram_msg: shouldAlert ? `🚨 **LINIJA STOJI!**\\nСтоји већ: **${diffMinutes} min**\\nПоследњи сигнал: ${lastSeen.toLocaleTimeString('sr-RS')}` : \"OK\"\n};"
