    {
      "parameters": {
        "jsCode": "// 1. ПРЕУЗИМАЊЕ ПОДАТАКА СА ЗАШТИТОМ\nconst codeNode = $node[\"Code in JavaScript\"]?.json || {};\nconst dbNode = $node[\"Get row(s)\"]?.json || {};\n\nconst currentImpulse = new Date(codeNode.timestamp || new Date());\nconst lastPieceTime = new Date(dbNode.last_piece_time || codeNode.timestamp);\n\nconst prevGood = parseInt(dbNode.good_pieces) || 0;\nconst prevBad = parseInt(dbNode.bad_pieces) || 0;\nconst prevTotal = parseInt(dbNode.total_pieces) || 0;\n\n// 2. КАЛКУЛАЦИЈА ВРЕМЕНА\nconst deltaS = Math.floor((currentImpulse - lastPieceTime) / 1000);\n\n// 3. ПРАВИЛО КВАЛИТЕТА (> 15с = Bad)\nlet isGood = deltaS <= 15 ? 1 : 0;\nlet isBad = deltaS > 15 ? 1 : 0;\n\n// 4. НОВИ БРОЈЕВИ\nconst newTotal = prevTotal + 1;\nconst newGood = prevGood + isGood;\nconst newBad = prevBad + isBad;\n\n// 5. OEE МАТЕМАТИКА СА ЗАШТИТОМ ОД NULL ВРЕДНОСТИ\nconst idealTime = newTotal * 10; \n\n// Безбедно преузимање старта смене (користимо createdAtAI или садашње време)\nconst rawStart = dbNode.createdAtAI || dbNode.last_piece_time || codeNode.timestamp;\nconst shiftStartTime = new Date(rawStart);\n\n// Осигуравамо да actualTime никада не буде 0 или NaN\nlet actualTime = Math.floor((currentImpulse - shiftStartTime) / 1000);\nif (actualTime <= 0) actualTime = 10; \n\n// Калкулација процената\nconst quality = (newGood / newTotal) * 100;\nconst performance = Math.min((idealTime / actualTime) * 100, 100);\nconst oee = ((performance / 100) * (quality / 100)) * 100;\n\nreturn {\n  new_total: newTotal,\n  new_good: newGood,\n  new_bad: newBad,\n  current_timestamp: currentImpulse.toISOString(),\n  delta_s: deltaS,\n  oee_percentage: Number(oee.toFixed(2)) || 0,\n  quality_score: Number(quality.toFixed(2)) || 0,\n  performance_score: Number(performance.toFixed(2)) || 0\n};"
      },
